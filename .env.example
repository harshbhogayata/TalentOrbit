# ─────────────────────────────────────────────────────────────────
# TalentOrbit Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Django secret key — generate a new one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production (never True in prod)
DEBUG=False

# Comma-separated list of allowed hostnames
# Example: ALLOWED_HOSTS=talentorbit.com,www.talentorbit.com
ALLOWED_HOSTS=talentorbit.com,www.talentorbit.com

# Canonical public URL used in verification emails.
PUBLIC_APP_URL=https://talentorbit.com

# ── Database ─────────────────────────────────────────────────────
# For SQLite (development only):
#   DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (production):
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/talentorbit

# Connection pool — seconds to keep idle DB connections open
CONN_MAX_AGE=600

# ── Email ────────────────────────────────────────────────────────
# Format: smtp://user:password@host:port/?tls=True
# Example using Gmail App Password:
# If your SMTP username or password contains reserved URL characters, URL-encode them.
EMAIL_URL=smtp://your-email@gmail.com:your-app-password@smtp.gmail.com:587/?tls=True
EMAIL_SEND_MAX_ATTEMPTS=2
EMAIL_RETRY_DELAY_SECONDS=1
VERIFICATION_EMAIL_TIMEOUT=8
VERIFICATION_EMAIL_MAX_ATTEMPTS=1
# If EMAIL_URL parsing causes trouble, you can set these instead:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Optional SMTP transport fallback (useful when 587/STARTTLS is blocked):
# EMAIL_FALLBACK_PORT=465
# EMAIL_FALLBACK_USE_SSL=True
# Keep this as the same mailbox, or an approved alias, for your SMTP provider.
DEFAULT_FROM_EMAIL=TalentOrbit <your-email@gmail.com>

# ── Razorpay ─────────────────────────────────────────────────────
# Get live keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# ── Cloudinary (Free Image/Video Hosting) ────────────────────────
# Get free keys from: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
